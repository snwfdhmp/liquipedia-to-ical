[Unit]
Description=com.snwfdhmp.liquipedia-cal
After=network.target

[Service]
WorkingDirectory=/opt/github.com/snwfdhmp/liquipedia-cal
ExecStart=/usr/local/bin/pnpm start -q
Restart=on-failure
RestartSec=10
SyslogIdentifier=com.snwfdhmp.liquipedia-cal
# These are environment variables, not unit directives. Written bare they were
# not "the ports this service runs on" -- systemd logged "Unknown key 'HTTP_PORT'
# in section [Service], ignoring" and dropped both, and the service only landed
# on 9059/7488 because those happen to be the fallbacks in main.ts. Changing a
# number here would have silently done nothing. nginx proxies ics.snwfdhmp.com
# to 9059 and the MCP API to 7488, so these values are load-bearing.
Environment=HTTP_PORT=9059
Environment=MCP_PORT=7488

[Install]
WantedBy=multi-user.target
